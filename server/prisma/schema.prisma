generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  USER
}

enum ShipmentStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum VatRate {
  NONE
  VAT0
  VAT10
  VAT20
}

enum BarcodeType {
  EAN13
  CODE128
  UPC
  QR
}

enum ReceiptStatus {
  DRAFT
  POSTED
  CANCELLED
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  username  String?
  firstName String?
  lastName  String?
  phone     String?
  role      Role[]   @default([USER])
  avatar    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tokens        Token[]
  messages      Message[]
  projects      Project[]
  products      Product[]      @relation("ProductCreatedBy")
  goodsReceipts GoodsReceipt[] @relation("ReceiptCreatedBy")
}

model Token {
  id      String   @id @default(uuid())
  token   String   @unique
  expires DateTime
  userId  String
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Category {
  id        String     @id @default(uuid())
  name      String     @unique
  parentId  String?
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  Category[] @relation("CategoryTree")
  products  Product[]
  createdAt DateTime   @default(now())
}

model Manufacturer {
  id        String    @id @default(uuid())
  name      String    @unique
  country   String?
  products  Product[]
  createdAt DateTime  @default(now())
}

model Unit {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  symbol    String   @unique

  productsBase     Product[]          @relation("BaseUnit")
  productsPurchase Product[]          @relation("PurchaseUnit")
  productsSale     Product[]          @relation("SaleUnit")
  receiptItems     GoodsReceiptItem[] @relation("ReceiptUnit")
}

model Product {
  id            String   @id @default(uuid())
  sku           String   @unique
  title         String
  description   String?
  categoryId    String?
  category      Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  manufacturerId String?
  manufacturer  Manufacturer? @relation(fields: [manufacturerId], references: [id], onDelete: SetNull)

  baseUnitId     String
  baseUnit       Unit    @relation("BaseUnit", fields: [baseUnitId], references: [id], onDelete: Restrict)
  purchaseUnitId String?
  purchaseUnit   Unit?   @relation("PurchaseUnit", fields: [purchaseUnitId], references: [id], onDelete: SetNull)
  purchaseToBase Float   @default(1)
  saleUnitId     String?
  saleUnit       Unit?   @relation("SaleUnit", fields: [saleUnitId], references: [id], onDelete: SetNull)
  saleToBase     Float   @default(1)

  purchasePrice Float?
  estimatePrice Float?
  salePrice     Float?
  vatRate       VatRate @default(VAT20)

  weightKg Float?
  lengthMm Float?
  widthMm  Float?
  heightMm Float?
  volumeM3 Float?
  grade    String?
  material String?
  gost     String?
  country  String?

  minStock Float?
  isActive Boolean @default(true)

  imageUrl  String?
  imageData Bytes?
  imageType String?

  createdById String?
  createdBy   User?  @relation("ProductCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  images         ProductImage[]
  barcodes       Barcode[]
  stockItems     StockItem[]
  shipmentItems  ShipmentItem[]
  stockTransfers StockTransfer[]
  receiptItems   GoodsReceiptItem[]
}

model Barcode {
  id        String      @id @default(uuid())
  productId String
  product   Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  value     String      @unique
  type      BarcodeType @default(EAN13)
  isPrimary Boolean     @default(false)
}

model ProductImage {
  id        String  @id @default(uuid())
  url       String
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Warehouse {
  id        String   @id @default(uuid())
  name      String   @unique
  address   String?
  latitude  Float?
  longitude Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stockItems     StockItem[]
  shipments      Shipment[]
  transfersFrom  StockTransfer[] @relation("FromWarehouse")
  transfersTo    StockTransfer[] @relation("ToWarehouse")
  goodsReceipts  GoodsReceipt[]
}

model StockItem {
  id            String   @id @default(uuid())
  productId     String
  warehouseId   String
  quantity      Float    @default(0)
  purchasePrice Float?
  estimatePrice Float?
  salePrice     Float?
  discount      Float?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  product   Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  @@unique([productId, warehouseId])
}

model Object {
  id          String   @id @default(uuid())
  name        String   @unique
  address     String?
  latitude    Float?
  longitude   Float?
  description String?
  cameraUrl   String?
  cameraType  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  shipments Shipment[]
}

model Shipment {
  id          String         @id @default(uuid())
  warehouseId String
  objectId    String
  status      ShipmentStatus @default(PENDING)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  warehouse Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  object    Object         @relation(fields: [objectId], references: [id], onDelete: Restrict)
  items     ShipmentItem[]
}

model ShipmentItem {
  id         String @id @default(uuid())
  shipmentId String
  productId  String
  quantity   Float

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([shipmentId, productId])
}

model GoodsReceipt {
  id          String        @id @default(uuid())
  number      String        @unique
  warehouseId String
  supplier    String?
  receiptDate DateTime      @default(now())
  status      ReceiptStatus @default(DRAFT)
  comment     String?
  createdById String?
  createdBy   User?         @relation("ReceiptCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  warehouse Warehouse         @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  items     GoodsReceiptItem[]
}

model GoodsReceiptItem {
  id        String  @id @default(uuid())
  receiptId String
  productId String
  // Количество в базовой единице хранения (для остатка).
  quantity Float
  // Единица, в которой физически приняли товар, и её количество (для отображения строки).
  unitId       String
  unitQuantity Float
  // Снимок коэффициента пересчёта: сколько базовых единиц в одной единице приёмки.
  unitFactor Float
  // Цена за единицу приёмки (unitId).
  purchasePrice Float?

  receipt GoodsReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  product Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  unit    Unit          @relation("ReceiptUnit", fields: [unitId], references: [id], onDelete: Restrict)

  @@unique([receiptId, productId])
}

model Message {
  id        Int      @id @default(autoincrement())
  userId    String
  userName  String
  text      String
  createdAt DateTime @default(now())

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  attachments Attachment[]
}

model Attachment {
  id         String   @id @default(uuid())
  messageId  Int
  fileName   String
  fileSize   Int
  mimeType   String
  data       Bytes
  uploadedAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
}

model Project {
  id        String   @id @default(uuid())
  name      String
  config    Json
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StockTransfer {
  id              String   @id @default(uuid())
  productId       String
  quantity        Float
  fromWarehouseId String
  toWarehouseId   String
  createdAt       DateTime @default(now())

  product       Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  fromWarehouse Warehouse @relation("FromWarehouse", fields: [fromWarehouseId], references: [id], onDelete: Restrict)
  toWarehouse   Warehouse @relation("ToWarehouse", fields: [toWarehouseId], references: [id], onDelete: Restrict)
}
